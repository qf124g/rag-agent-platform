# 模型服务（OpenAI 兼容协议，用于对话模型）
# API Key 从本机环境变量读取（OPENAI_API_KEY 或 DASHSCOPE_API_KEY），此文件不放密钥
OPENAI_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 对话模型（需支持 function calling）
LLM_MODEL=qwen3.8-max

# 本地向量模型（fastembed 在本机运行，无需 API Key，首次使用自动下载模型）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
